generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR_MANAGER
  HR_PAYROLL_USER
  HR_PAYROLL_MANAGER
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum ContractStatus {
  ACTIVE
  EXPIRED
}

enum AttendanceStatus {
  NORMAL
  LATE
  ABSENT
  MANUAL_EDIT
}

enum TimeOffUnit {
  DAYS
  HOURS
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REFUSED
}

enum SalaryRuleCategory {
  BASIC
  ALLOWANCE
  DEDUCTION
  GROSS
  NET
}

enum ComputationType {
  FIXED
  PERCENTAGE
}

enum PayrunStatus {
  DRAFT
  COMPUTED
  VALIDATED
  PAID
}

model User {
  id              Int              @id @default(autoincrement())
  name            String
  email           String           @unique
  passwordHash    String
  role            Role             @default(EMPLOYEE)
  employeeId      Int?             @unique
  employee        Employee?        @relation(fields: [employeeId], references: [id])
  approvedTimeOff TimeOffRequest[] @relation("TimeOffApprover")
  createdPayruns  Payrun[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Employee {
  id                 Int                 @id @default(autoincrement())
  name               String
  email              String              @unique
  department         String
  jobPosition        String
  managerId          Int?
  manager            Employee?           @relation("EmployeeManager", fields: [managerId], references: [id])
  reports            Employee[]          @relation("EmployeeManager")
  scheduleId         Int?
  schedule           WorkingSchedule?    @relation(fields: [scheduleId], references: [id])
  status             EmployeeStatus      @default(ACTIVE)
  dateJoined         DateTime            @default(now()) @db.Date
  user               User?
  contracts          Contract[]
  attendance         Attendance[]
  timeOffAllocations TimeOffAllocation[]
  timeOffRequests    TimeOffRequest[]
  payrolls           Payroll[]
  payslips           Payslip[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([managerId])
}

model Contract {
  id                Int             @id @default(autoincrement())
  employeeId        Int
  employee          Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate         DateTime        @db.Date
  endDate           DateTime?       @db.Date
  wage              Decimal         @db.Decimal(12, 2)
  salaryStructureId Int
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id])
  payslips          Payslip[]
  status            ContractStatus  @default(ACTIVE)
  department        String
  position          String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([employeeId])
}

model SalaryStructure {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  active    Boolean      @default(true)
  rules     SalaryRule[]
  contracts Contract[]
  payruns   Payrun[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// The payroll engine reads these in `sequence` order. `percentageOfCode` may only name a rule
// with a lower sequence, which is what keeps the dependency graph acyclic and evaluable in one
// forward pass. salaryService enforces that across the whole structure, not just per row.
model SalaryRule {
  id               Int                @id @default(autoincrement())
  structureId      Int
  structure        SalaryStructure    @relation(fields: [structureId], references: [id], onDelete: Cascade)
  name             String
  code             String
  category         SalaryRuleCategory
  sequence         Int
  computationType  ComputationType
  value            Decimal            @db.Decimal(12, 2)
  percentageOfCode String?
  payslipLines     PayslipLine[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([structureId, code])
  @@unique([structureId, sequence])
}

model Payrun {
  id                Int             @id @default(autoincrement())
  name              String
  periodStart       DateTime        @db.Date
  periodEnd         DateTime        @db.Date
  salaryStructureId Int
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id])
  status            PayrunStatus    @default(DRAFT)
  createdById       Int
  createdBy         User            @relation(fields: [createdById], references: [id])
  payslips          Payslip[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([salaryStructureId])
}

model Payslip {
  id          Int           @id @default(autoincrement())
  payrunId    Int
  payrun      Payrun        @relation(fields: [payrunId], references: [id], onDelete: Cascade)
  employeeId  Int
  employee    Employee      @relation(fields: [employeeId], references: [id])
  contractId  Int
  contract    Contract      @relation(fields: [contractId], references: [id])
  workedDays  Decimal       @default(0) @db.Decimal(6, 2)
  status      PayrunStatus  @default(DRAFT)
  gross       Decimal       @default(0) @db.Decimal(12, 2)
  net         Decimal       @default(0) @db.Decimal(12, 2)
  generatedAt DateTime      @default(now())
  lines       PayslipLine[]

  @@unique([payrunId, employeeId])
  @@index([employeeId])
  @@index([contractId])
}

model PayslipLine {
  id           Int        @id @default(autoincrement())
  payslipId    Int
  payslip      Payslip    @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  salaryRuleId Int
  salaryRule   SalaryRule @relation(fields: [salaryRuleId], references: [id])
  name         String
  amount       Decimal    @db.Decimal(12, 2)

  @@unique([payslipId, salaryRuleId])
}

// pattern: [{ day, startTime, endTime, breakMinutes }]
model WorkingSchedule {
  id          Int        @id @default(autoincrement())
  name        String
  type        String
  weeklyHours Decimal    @db.Decimal(5, 2)
  pattern     Json
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// workedHours is derived from checkOut - checkIn in attendanceService, never trusted from a client.
model Attendance {
  id          Int              @id @default(autoincrement())
  employeeId  Int
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  checkIn     DateTime
  checkOut    DateTime?
  workedHours Decimal?         @db.Decimal(5, 2)
  status      AttendanceStatus @default(NORMAL)
  createdAt   DateTime         @default(now())

  @@index([employeeId, date])
}

model TimeOffType {
  id                 Int                 @id @default(autoincrement())
  name               String              @unique
  unit               TimeOffUnit         @default(DAYS)
  requiresAllocation Boolean             @default(true)
  affectsPayroll     Boolean             @default(false)
  allocations        TimeOffAllocation[]
  requests           TimeOffRequest[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

// `remaining` (allocated - taken) is derived in timeOffService, never stored.
model TimeOffAllocation {
  id            Int         @id @default(autoincrement())
  employeeId    Int
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timeOffTypeId Int
  timeOffType   TimeOffType @relation(fields: [timeOffTypeId], references: [id])
  allocated     Decimal     @db.Decimal(6, 2)
  taken         Decimal     @default(0) @db.Decimal(6, 2)
  validFrom     DateTime    @db.Date
  validTo       DateTime    @db.Date
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([employeeId, timeOffTypeId])
}

// startDate/endDate are full timestamps, not dates: a HOURS-unit type needs the time of day to
// derive a duration at all. A DAYS-unit type only reads the calendar day off them.
model TimeOffRequest {
  id            Int           @id @default(autoincrement())
  employeeId    Int
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timeOffTypeId Int
  timeOffType   TimeOffType   @relation(fields: [timeOffTypeId], references: [id])
  startDate     DateTime
  endDate       DateTime
  duration      Decimal       @db.Decimal(6, 2)
  status        TimeOffStatus @default(PENDING)
  approvedById  Int?
  approvedBy    User?         @relation("TimeOffApprover", fields: [approvedById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([employeeId, status])
}

model Payroll {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month      Int
  year       Int
  baseSalary Float
  bonus      Float    @default(0)
  deductions Float    @default(0)
  netPay     Float
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  @@unique([employeeId, month, year])
}
